    {
      "name": "correcao",
      "definition": "select `tb1`.`mes` AS `mes`,(`tb1`.`maximo` / `tb1`.`indice`) AS `correcao` from (select `fidaf`.`ipca`.`mes` AS `mes`,`fidaf`.`ipca`.`indice` AS `indice`,(select max(`fidaf`.`ipca`.`indice`) from `fidaf`.`ipca`) AS `maximo` from `fidaf`.`ipca`) `tb1`",
      "algorithm": "undefined",
      "sqlSecurity": "definer",
      "withCheckOption": null,
      "entityType": "views"
    },
    {
      "name": "pontos",
      "definition": "select ((`tb2`.`pontos` + ((12 - `tb2`.`total`) * `tb2`.`ultimo`)) / 12) AS `pontos` from (select sum(`tb1`.`pontos`) AS `pontos`,sum(if((`tb1`.`mes` = `tb1`.`ultimo`),`tb1`.`pontos`,0)) AS `ultimo`,count(0) AS `total` from (select `fidaf`.`pm`.`mes` AS `mes`,`fidaf`.`pm`.`pontos` AS `pontos`,(select max(`fidaf`.`pontos_mes`.`mes`) from `fidaf`.`pontos_mes`) AS `ultimo` from `fidaf`.`pontos_mes` `pm`) `tb1`) `tb2`",
      "algorithm": "undefined",
      "sqlSecurity": "definer",
      "withCheckOption": null,
      "entityType": "views"
    },
    {
      "name": "pontos_mes",
      "definition": "select `ct1`.`mes` AS `mes`,sum(`ct1`.`pontos`) AS `pontos`,count(0) AS `total` from (select `s`.`mes` AS `mes`,`c`.`pontos` AS `pontos` from (`fidaf`.`servidores` `s` join `fidaf`.`cargos` `c` on((`c`.`nome` = `s`.`cargo`)))) `ct1` group by `ct1`.`mes`",
      "algorithm": "undefined",
      "sqlSecurity": "definer",
      "withCheckOption": null,
      "entityType": "views"
    },
    {
      "name": "recolhimento_diario",
      "definition": "select date_format(`rec`.`data`,'%Y-%m-%d') AS `data`,`cod`.`imposto` AS `imposto`,sum(`rec`.`valor`) AS `nominal`,(sum(`rec`.`valor`) * `fidaf`.`cor`.`correcao`) AS `corrigido` from ((`fidaf`.`recolhimento` `rec` left join `fidaf`.`codigos` `cod` on((`cod`.`codigo` = `rec`.`codigo`))) left join `fidaf`.`correcao` `cor` on((`fidaf`.`cor`.`mes` = date_format(`rec`.`data`,'%Y-%m')))) group by date_format(`rec`.`data`,'%Y-%m-%d'),`cod`.`imposto`,`fidaf`.`cor`.`correcao`",
      "algorithm": "undefined",
      "sqlSecurity": "definer",
      "withCheckOption": null,
      "entityType": "views"
    },
    {
      "name": "resumo",
      "definition": "select date_format(`rec`.`data`,'%Y-%m') AS `mes`,`cod`.`imposto` AS `imposto`,sum(`rec`.`valor`) AS `nominal`,(sum(`rec`.`valor`) * `fidaf`.`cor`.`correcao`) AS `corrigido` from ((`fidaf`.`recolhimento` `rec` left join `fidaf`.`codigos` `cod` on((`cod`.`codigo` = `rec`.`codigo`))) left join `fidaf`.`correcao` `cor` on((`fidaf`.`cor`.`mes` = date_format(`rec`.`data`,'%Y-%m')))) group by date_format(`rec`.`data`,'%Y-%m'),`cod`.`imposto`,`fidaf`.`cor`.`correcao`",
      "algorithm": "undefined",
      "sqlSecurity": "definer",
      "withCheckOption": null,
      "entityType": "views"
    },
    {
      "name": "status",
      "definition": "select `c`.`imposto` AS `imposto`,sum(`r`.`valor`) AS `valor` from (`fidaf`.`recolhimento` `r` join `fidaf`.`codigos` `c` on((`c`.`codigo` = `r`.`codigo`))) where (year(`r`.`data`) = 2025) group by `c`.`imposto`",
      "algorithm": "undefined",
      "sqlSecurity": "definer",
      "withCheckOption": null,
      "entityType": "views"
    },
    {
      "name": "view_datas",
      "definition": "with recursive `datas` as (select cast('2025-01-01' as date) AS `data` union all select (`datas`.`data` + interval 1 day) AS `DATE_ADD(data, INTERVAL 1 DAY)` from `datas` where (`datas`.`data` < '2025-12-31')) select `datas`.`data` AS `data` from `datas`",
      "algorithm": "undefined",
      "sqlSecurity": "definer",
      "withCheckOption": null,
      "entityType": "views"
    }
